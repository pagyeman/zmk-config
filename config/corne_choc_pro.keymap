#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    behaviors {
        // use tapdance to toggle CAPS LOCK
        td_shift: td_shift {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };
        // use Mod-Morph to get same behavior of Forward Slash / Back Slash on Windows as on Mac
        mm_slash: mm_slash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N7)>, <&kp RALT(NUBS)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        // switch BT profile and at the same time switch keyboard layer (used to accomodate swiss mac and pc layouts)
        // accepts two parameters
        tbl: tbl {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;  // no delay when doing both actions
            tap-ms = <0>;  // keys are not pressed for long
            #binding-cells = <2>;
            bindings
                = <&macro_param_1to1>
                , <&bt BT_SEL MACRO_PLACEHOLDER>
                , <&macro_param_2to1>
                , <&to MACRO_PLACEHOLDER>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "MACQWERTY";

            // --------------------------------------------------------------------------------------------------------------------------
            // |      |  Q  |  W  |  F  |  P        |  B         |      |      |  J       |  L           |  U  |  Y  |  TG glow  |      |
            // | TAB  |  A  |  R  |  S  |  T        |  G         |   &  |   $  |  M       |  N           |  E  |  I  |  O        |  !   |
            // | LALT |  Z  |  X  |  C  |  D        |  V         |             |  K       |  H           |  ,  |  .  |  /        |  ?   |
            //                    | GUI | SHFT/CAPS | ESC/Layer4 |             | ENT/CTRL | SPACE/Layer2 | ALT |

            bindings = <
&none     &kp Q  &kp W  &kp F     &kp P      &kp B      &none       &none     &kp J            &kp L        &kp U      &kp Z    &bl BL_TOG  &none
&kp TAB   &kp A  &kp R  &kp S     &kp T      &kp G      &kp LS(N6)  &kp BSLH  &kp M            &kp N        &kp E      &kp I    &kp O       &kp RS(RBKT)
&kp LALT  &kp Y  &kp X  &kp C     &kp D      &kp V                            &kp K            &kp H        &kp COMMA  &kp DOT  &kp RS(N7)  &kp RS(MINUS)
                        &kp LGUI  &td_shift  &lt 4 ESC                        &mt LCTRL ENTER  &lt 2 SPACE  &kp RALT
            >;
        };

        lower_layer {
            display-name = "PCQWERTY";

            // ----------------------------------------------------------------------------------------------------------------------------------
            // |      |  Q  |  W  |  F  |  P        |  B         |      |      |  J       |  L           |  U  |  Y  |  TG glow  | Print Screen |
            // | TAB  |  A  |  R  |  S  |  T        |  G         |   &  |   $  |  M       |  N           |  E  |  I  |  O        |  !           |
            // | LALT |  Z  |  X  |  C  |  D        |  V         |             |  K       |  H           |  ,  |  .  |  /        |  ?           |
            //                    | GUI | SHFT/CAPS | ESC/Layer5 |             | ENT/CTRL | SPACE/Layer3 | ALT |

            bindings = <
&none     &kp Q  &kp W  &kp F     &kp P      &kp B         &none       &none     &kp J            &kp L        &kp U      &kp Z    &bl BL_TOG  &kp PSCRN
&kp TAB   &kp A  &kp R  &kp S     &kp T      &kp G         &kp LS(N6)  &kp BSLH  &kp M            &kp N        &kp E      &kp I    &kp O       &kp RS(RBKT)
&kp LALT  &kp Y  &kp X  &kp C     &kp D      &kp V                               &kp K            &kp H        &kp COMMA  &kp DOT  &mm_slash   &kp RS(MINUS)
                        &kp LGUI  &td_shift  &lt 5 ESC                           &mt LCTRL ENTER  &lt 3 SPACE  &kp RALT
            >;
        };

        raise_layer {
            display-name = "MACBRACKET";

            // ----------------------------------------------------------------------------------------------------------
            // |  '   |  ¨   |  @   |   {   |  }   |  |   | Unlock |      |      |        |        |      |      |      |
            // |  "   |  #   |  $   |   (   |  )   |  `   |        |      |      | Layer6 | Layer7 |      |      |      |
            // |      |  %   |  ^   |   [   |  ]   |  ~   |               |      |        |        |      |      |      |
            //                      |       |  _   | BKSP |               |      | Trans  |        |

            bindings = <
&kp MINUS   &kp RIGHT_BRACKET  &kp RA(G)   &kp RA(N8)  &kp RA(N9)     &kp RA(N7)     &studio_unlock  &none  &none  &none   &none  &none  &none  &none
&kp LS(N2)  &kp RA(N3)         &kp BLSH    &kp LS(N8)  &kp LS(N9)     &kp RS(EQUAL)  &none           &none  &none  &tog 6  &tog 7 &none  &none  &none
&none       &kp RS(N5)         &kp EQUAL   &kp RA(N5)  &kp RA(N6)     &kp RA(N)                             &none  &none   &none  &none  &none  &none
                                           &none       &kp RS(SLASH)  &kp BSPC                              &none  &trans  &none
            >;
        };

        extra_layer_1 {
            display-name = "PCBRACKET";

            // ----------------------------------------------------------------------------------------------------------
            // |  '   |  ¨   |  @   |   {   |  }   |  |   | Unlock |      |      |        |        |      |      |      |
            // |  "   |  #   |  $   |   (   |  )   |  `   |        |      |      | Layer3 | Layer4 |      |      |      |
            // |      |  %   |  ^   |   [   |  ]   |  ~   |               |      |        |        |      |      |      |
            //                      |       |  _   | BKSP |               |      | Trans  |        |

            bindings = <
&kp MINUS   &kp RIGHT_BRACKET  &kp RA(N2)  &kp RA(APOS)  &kp RA(BSLH)   &kp RA(N7)     &studio_unlock  &none  &none  &none   &none  &none  &none  &none
&kp LS(N2)  &kp RA(N3)         &kp BSLH    &kp LS(N8)    &kp LS(N9)     &kp RS(EQUAL)  &none           &none  &none  &tog 6  &tog 7 &none  &none  &none
&none       &kp RS(N5)         &kp EQUAL   &kp RA(LBKT)  &kp RA(RBKT)   &kp RA(EQUAL)                         &none  &none   &none  &none  &none  &none
                                           &none         &kp RS(SLASH)  &kp BACKSPACE                         &none  &trans  &none
            >;
        };

        extra_layer_2 {
            display-name = "MACNUMBER";

            // ----------------------------------------------------------------------------------------------------
            // |      |      | BT 0 | BT 1 | BT 2 | BT CLR |      |      |  /   |  7   |  8   |  9  |  *   |      |
            // |      |      |      |  <   |  >   |        |      |      |  -   |  4   |  5   |  6  |  +   |      |
            // |      |      |      |      |      |        |             |      |  1   |  2   |  3  |      |      |
            //                      |      |      | Trans  |             |  =   |  0   |      |

            bindings = <
&none  &none  &tbl 0 0  &tbl 1 1   &bt BT_SEL 2   &bt BT_CLR   &none  &none  &kp LS(N7)  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp RS(N3)  &none
&none  &none  &none     &kp GRAVE  &kp LS(GRAVE)  &none        &none  &none  &kp SLASH   &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp RS(N1)  &none
&none  &none  &none     &none      &none          &none                      &none       &kp KP_N1  &kp KP_N2  &kp KP_N3  &none       &none
                        &none      &none          &trans                     &kp RS(N0)  &kp N0     &none
            >;
        };

        extra_layer_3 {
            display-name = "PCNUMBER";

            // ----------------------------------------------------------------------------------------------------
            // |      |      | BT 0 | BT 1 | BT 2 | BT CLR |      |      |  /   |  7   |  8   |  9  |  *   |      |
            // |      |      |      |  <   |  >   |        |      |      |  -   |  4   |  5   |  6  |  +   |      |
            // |      |      |      |      |      |        |             |      |  1   |  2   |  3  |      |      |
            //                      |      |      | Trans  |             |  =   |  0   |      |

            bindings = <
&none  &none  &tbl 0 0  &tbl 1 1   &bt BT_SEL 2   &bt BT_CLR   &none  &none  &kp LS(N7)  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp RS(N3)  &none
&none  &none  &none     &kp NUBS   &kp LS(NUBS)   &none        &none  &none  &kp SLASH   &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp RS(N1)  &none
&none  &none  &none     &none      &none          &none                      &none       &kp KP_N1  &kp KP_N2  &kp KP_N3  &none       &none
                        &none      &none          &trans                     &kp RS(N0)  &kp N0     &none
            >;
        };

        extra_layer_4 {
            display-name = "ARROWKEY";

            // ---------------------------------------------------------------------------------------------------------------------
            // |       |       |       |       |       |       |       |       |       | PG-UP   |  UP   | PG-DOWN |       |       |
            // |       | CMD   | CTRL  | LALT  | SHIFT |       |       |       |       | LEFT    | DOWN  | RIGHT   |       |       |
            // |       |       |       |       |       |       |               |       |         |       |         |       |       |
            //                         |       |       |       |               |       | Layer 3 |       |

            bindings = <
&none  &none         &none             &none         &none           &none  &none  &none  &none  &kp PAGE_UP  &kp UP_ARROW  &kp PAGE_DOWN  &none  &none
&none  &kp LEFT_GUI  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_SHIFT  &none  &none  &none  &none  &kp LEFT     &kp DOWN      &kp RIGHT      &none  &none
&none  &none         &none             &none         &none           &none                &none  &none        &none         &none          &none  &none
                                       &none         &none           &none                &none  &tog 6       &none
            >;
        };

        extra_layer_5 {
            display-name = "MOUSE";

            // ------------------------------------------------------------------------------------------------------------------------------------
            // |       |       |       |       |       |       |       |       |       | LClick     | Mouse-UP    | RClick        |       |       |
            // |       | CMD   | CTRL  | LALT  | SHIFT |       |       |       |       | Mouse-LEFT | Mouse-DOWN  | Mouse-RIGHT   |       |       |
            // |       |       |       |       |       |       |               |       | Scroll-Up  |             | Scroll-Down   |       |       |
            //                         |       |       |       |               |       | Layer 4    |             |
            
            bindings = <
&none  &none          &none              &none         &none           &none  &none  &none  &none  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &none  &none
&none  &kp RIGHT_GUI  &kp RIGHT_CONTROL  &kp LEFT_ALT  &kp LEFT_SHIFT  &none  &none  &none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &none
&none  &none          &none              &none         &none           &none                &none  &msc SCRL_UP    &none           &msc SCRL_DOWN   &none  &none
                                         &none         &none           &none                &none  &tog 7          &none
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
    };
};
