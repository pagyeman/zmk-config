#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    behaviors {
        td_shift: td_shift {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SHIFT";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };
    };

    macros {
        // switch to BT profile and set the active layer at the same time
        // we use parameters to avoid duplication of code
        bt_sel_layer: bt_sel_layer {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>; // we want immediate action, without delay
            tap-ms = <0>;  // don't tap for long
            #binding-cells = <2>;
            bindings
            = <&macro_param_1to1>
            , <&bt BT_SEL MACRO_PLACEHOLDER>
            , <&macro_param_2to1>
            , <&to MACRO_PLACEHOLDER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------------------------------------------------
            // |      |  Q  |  W  |  F  |  P        |  B         |      |      |  J       |  L           |  U  |  Y  |  TG glow  |      |
            // | TAB  |  A  |  R  |  S  |  T        |  G         |   &  |   $  |  M       |  N           |  E  |  I  |  O        |  !   |
            // | LALT |  Z  |  X  |  C  |  D        |  V         |             |  K       |  H           |  ,  |  .  |  /        |  ?   |
            //                    | GUI | SHFT/CAPS | ESC/Layer2 |             | ENT/CTRL | SPACE/Layer1 | ALT |

            bindings = <
&none         &kp Q  &kp W  &kp F     &kp P      &kp B         &none       &none          &kp J                   &kp L        &kp U      &kp Z    &bl BL_TOG        &none
&kp TAB       &kp A  &kp R  &kp S     &kp T      &kp G         &kp LS(N6)  &kp BACKSLASH  &kp M                   &kp N        &kp E      &kp I    &kp O             &kp RS(RIGHT_BRACKET)
&kp LEFT_ALT  &kp Y  &kp X  &kp C     &kp D      &kp V                                    &kp K                   &kp H        &kp COMMA  &kp DOT  &kp RS(NUMBER_7)  &kp RS(MINUS)
                            &kp LGUI  &td_shift  &lt 2 ESCAPE                             &mt LEFT_CONTROL ENTER  &lt 1 SPACE  &kp RALT
            >;
        };

        lower_layer {
            display-name = "BRACKET";

            // ----------------------------------------------------------------------------------------------------------
            // |  '   |  ¨   |  @   |   {   |  }   |  |   | Unlock |      |      |        |        |      |      |      |
            // |  "   |  #   |  $   |   (   |  )   |  `   |        |      |      | Layer3 | Layer4 |      |      |      |
            // |      |  %   |  ^   |   [   |  ]   |  ~   |               |      |        |        |      |      |      |
            //                      |       |  _   | BKSP |               |      | Trans  |        |

            bindings = <
&kp MINUS         &kp RIGHT_BRACKET  &kp RA(G)   &kp RA(NUMBER_8)  &kp RA(NUMBER_9)  &kp RA(NUMBER_7)  &studio_unlock  &none  &none  &none   &none  &none  &none  &none
&kp LS(NUMBER_2)  &kp RA(NUMBER_3)   &kp DOLLAR  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp RS(EQUAL)     &none           &none  &none  &tog 3  &tog 4 &none  &none  &none
&none             &kp RS(NUMBER_5)   &kp EQUAL   &kp RA(NUMBER_5)  &kp RA(NUMBER_6)  &kp RA(N)                                &none  &none   &none  &none  &none  &none
                                                 &none             &kp RS(SLASH)     &kp BACKSPACE                            &none  &trans  &none
            >;
        };

        raise_layer {
            display-name = "NUMBER";

            // ----------------------------------------------------------------------------------------------------
            // |      |      | BT 0 | BT 1 | BT 2 | BT CLR |      |      |  /   |  7   |  8   |  9  |  *   |      |
            // |      |      |      |  <   |  >   |        |      |      |  -   |  4   |  5   |  6  |  +   |      |
            // |      |      |      |      |      |        |             |      |  1   |  2   |  3  |      |      |
            //                      |      |      | Trans  |             |  =   |  0   |      |

            bindings = <
&none  &none  &bt_sel_layer 0 0  &bt_sel_layer 1 5  &bt BT_SEL 2   &bt BT_CLR   &none  &none  &kp LS(NUMBER_7)  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp RS(NUMBER_3)  &none
&none  &none  &none              &kp GRAVE          &kp LS(GRAVE)  &none        &none  &none  &kp SLASH         &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp RS(NUMBER_1)  &none
&none  &none  &none              &none              &none          &none                      &none             &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &none             &none
                                 &none              &none          &trans                     &kp RS(NUMBER_0)  &kp NUMBER_0     &none
            >;
        };

        extra_layer_1 {
            display-name = "ARROWKEY";

            // ---------------------------------------------------------------------------------------------------------------------
            // |       |       |       |       |       |       |       |       |       | PG-UP   |  UP   | PG-DOWN |       |       |
            // |       | CMD   | CTRL  | LALT  | SHIFT |       |       |       |       | LEFT    | DOWN  | RIGHT   |       |       |
            // |       |       |       |       |       |       |               |       |         |       |         |       |       |
            //                         |       |       |       |               |       | Layer 3 |       |

            bindings = <
&none  &none         &none             &none         &none           &none  &none  &none  &none  &kp PAGE_UP  &kp UP_ARROW  &kp PAGE_DOWN  &none  &none
&none  &kp LEFT_GUI  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_SHIFT  &none  &none  &none  &none  &kp LEFT     &kp DOWN      &kp RIGHT      &none  &none
&none  &none         &none             &none         &none           &none                &none  &none        &none         &none          &none  &none
                                       &none         &none           &none                &none  &tog 3       &none
            >;
        };

        extra_layer_2 {
            display-name = "MOUSE";

            // ------------------------------------------------------------------------------------------------------------------------------------
            // |       |       |       |       |       |       |       |       |       | LClick     | Mouse-UP    | RClick        |       |       |
            // |       | CMD   | CTRL  | LALT  | SHIFT |       |       |       |       | Mouse-LEFT | Mouse-DOWN  | Mouse-RIGHT   |       |       |
            // |       |       |       |       |       |       |               |       | Scroll-Up  |             | Scroll-Down   |       |       |
            //                         |       |       |       |               |       | Layer 4    |             |
            
            bindings = <
&none  &none          &none              &none         &none           &none  &none  &none  &none  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &none  &none
&none  &kp RIGHT_GUI  &kp RIGHT_CONTROL  &kp LEFT_ALT  &kp LEFT_SHIFT  &none  &none  &none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &none
&none  &none          &none              &none         &none           &none                &none  &msc SCRL_UP    &none           &msc SCRL_DOWN   &none  &none
                                         &none         &none           &none                &none  &tog 4          &none
            >;
        };

        extra_layer_3 {
            display-name = "PCQWERTY";

            // --------------------------------------------------------------------------------------------------------------------------
            // |      |  Q  |  W  |  F  |  P        |  B         |      |      |  J       |  L           |  U  |  Y  |  TG glow  |      |
            // | TAB  |  A  |  R  |  S  |  T        |  G         |   &  |   $  |  M       |  N           |  E  |  I  |  O        |  !   |
            // | LALT |  Z  |  X  |  C  |  D        |  V         |             |  K       |  H           |  ,  |  .  |  /        |  ?   |
            //                    | GUI | SHFT/CAPS | ESC/Layer2 |             | ENT/CTRL | SPACE/Layer1 | ALT |

            bindings = <
&none         &kp Q  &kp W  &kp F     &kp P      &kp B         &none       &none          &kp J                   &kp L        &kp U      &kp Z    &bl BL_TOG        &none
&kp TAB       &kp A  &kp R  &kp S     &kp T      &kp G         &kp LS(N6)  &kp BACKSLASH  &kp M                   &kp N        &kp E      &kp I    &kp O             &kp RS(RIGHT_BRACKET)
&kp LEFT_ALT  &kp Y  &kp X  &kp C     &kp D      &kp V                                    &kp K                   &kp H        &kp COMMA  &kp DOT  &kp RS(NUMBER_7)  &kp RS(MINUS)
                            &kp LGUI  &td_shift  &lt 2 ESCAPE                             &mt LEFT_CONTROL ENTER  &lt 6 SPACE  &kp RALT
            >;
        };

        extra_layer_4 {
            display-name = "PCBRACKET";

            // ----------------------------------------------------------------------------------------------------------
            // |  '   |  ¨   |  @   |   {   |  }   |  |   | Unlock |      |      |        |        |      |      |      |
            // |  "   |  #   |  $   |   (   |  )   |  `   |        |      |      | Layer3 | Layer4 |      |      |      |
            // |      |  %   |  ^   |   [   |  ]   |  ~   |               |      |        |        |      |      |      |
            //                      |       |  _   | BKSP |               |      | Trans  |        |

            bindings = <
&kp MINUS         &kp RIGHT_BRACKET  &kp RA(G)   &kp RA(NUMBER_8)  &kp RA(NUMBER_9)  &kp RA(NUMBER_7)  &studio_unlock  &none  &none  &none   &none  &none  &none  &none
&kp LS(NUMBER_2)  &kp RA(NUMBER_3)   &kp DOLLAR  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp RS(EQUAL)     &none           &none  &none  &tog 3  &tog 4 &none  &none  &none
&none             &kp RS(NUMBER_5)   &kp EQUAL   &kp RA(NUMBER_5)  &kp RA(NUMBER_6)  &kp RA(N)                                &none  &none   &none  &none  &none  &none
                                                 &none             &kp RS(SLASH)     &kp BACKSPACE                            &none  &trans  &none
            >;
        };

        extra_layer_5 {
            display-name = "PCNUMBER";

            // ----------------------------------------------------------------------------------------------------
            // |      |      | BT 0 | BT 1 | BT 2 | BT CLR |      |      |  /   |  7   |  8   |  9  |  *   |      |
            // |      |      |      |  <   |  >   |        |      |      |  -   |  4   |  5   |  6  |  +   |      |
            // |      |      |      |      |      |        |             |      |  1   |  2   |  3  |      |      |
            //                      |      |      | Trans  |             |  =   |  0   |      |

            bindings = <
&none  &none  &bt_sel_layer 0 0  &bt_sel_layer 1 5  &bt BT_SEL 2   &bt BT_CLR   &none  &none  &kp LS(NUMBER_7)  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp RS(NUMBER_3)  &none
&none  &none  &none              &kp GRAVE          &kp LS(GRAVE)  &none        &none  &none  &kp SLASH         &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp RS(NUMBER_1)  &none
&none  &none  &none              &none              &none          &none                      &none             &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &none             &none
                                 &none              &none          &trans                     &kp RS(NUMBER_0)  &kp NUMBER_0     &none
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
    };
};
